const { Client } = require("pg");
async function testConnection() {
    const client = new Client({
        host: "[ENTER YOUR DB HOST HERE]", // DB host
        user: "[ENTER YOUR DB USERNAME HERE]", // DB username
        password: "[ENTER YOUR DB PASSWORD HERE]", // DB password
        database: "[ENTER YOUR DB NAME HERE]", // DB name
        port: [ENTER YOUR DB PORT HERE], // DB port
    });
    try {
        await client.connect();
        console.log("Database connected successfully!");
        const res = await client.query("SELECT version() AS version");
        console.log("PostgreSQL Version:", res.rows[0].version);
    } catch (err) {
        console.error("Database connection failed:");
        console.error(err.message);
    } finally {
        await client.end();
    }
}
testConnection();